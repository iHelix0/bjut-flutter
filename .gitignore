# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Private, unreviewed APK inventory output (never commit original APK bytes)
/private-analysis/
*.apk
*.aab
__pycache__/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local credentials, signing files and captured traffic
.env
.env.*
!.env.example
*.har
*.har.gz
*.proxyman
*.proxymansession
*.chls
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
*.provisionprofile
/captures/

# Machine-specific visual verification output
/docs/architecture/*.visual-check.json
