        "无网络、过期数据和字段变化均有失败态"
      ]
    },
    {
      "dot": "amber",
      "title": "当前待确认",
      "items": [
        "接口文档、字段和会话方式",
        "充值是否有沙箱、回调和对账接口",
        "MVP 的首轮真实验收平台"
      ]
    },
    {
      "dot": "rose",
      "title": "明确不进入首版",
      "items": [
        "代存统一身份认证密码",
        "充值交易先独立设计和验收",
        "绕过访问控制、风控或验证码"
      ]
    }
  ]
}
