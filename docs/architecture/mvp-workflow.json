    { "id": "build", "label": "实现", "fromCol": 4, "toCol": 4, "variant": "emphasis" },
    { "id": "acceptance", "label": "验收", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "scope_gate", "label": "MVP 范围门", "lane": "product", "fromCol": 0, "toCol": 1, "variant": "emphasis" },
