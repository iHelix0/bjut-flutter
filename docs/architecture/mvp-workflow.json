    { "id": "goal", "lane": "product", "col": 0, "type": "frontend", "label": "确认用户价值", "sublabel": "谁在何时查看什么" },
    { "id": "dataset", "lane": "product", "col": 1, "type": "database", "label": "四类核心数据", "sublabel": "课表·通知·余额·信息" },
    { "id": "source", "lane": "governance", "col": 2, "type": "external", "label": "接口取证", "sublabel": "来源、字段、频率" },
    { "id": "permission", "lane": "governance", "col": 3, "type": "security", "label": "落实授权范围", "sublabel": "读取、充值、代理分开", "tag": "已获授权" },
