    { "id": "decision", "lane": "product", "col": 5, "type": "messagebus", "label": "继续或收缩", "sublabel": "以证据决定下一步" },
    { "id": "fixture", "lane": "engineering", "col": 2, "type": "database", "label": "脱敏样本", "sublabel": "离线开发与测试" },
    { "id": "auth", "lane": "deferred", "col": 2, "type": "security", "label": "统一身份认证", "sublabel": "SSO、会话、退出" },
    { "id": "write", "lane": "deferred", "col": 5, "type": "external", "label": "充值交易专项", "sublabel": "订单、支付、回执" }
  ],
  "edges": [
    { "id": "goal_dataset", "from": "goal", "to": "dataset", "variant": "default" },
    { "id": "dataset_source", "from": "dataset", "to": "source", "variant": "default" },
    { "id": "source_permission", "from": "source", "to": "permission", "variant": "security" },
    { "id": "permission_contract", "from": "permission", "to": "contract", "variant": "emphasis" },
    { "id": "contract_slice", "from": "contract", "to": "slice", "variant": "default" },
    { "id": "slice_acceptance", "from": "slice", "to": "acceptance", "variant": "emphasis" },
    { "id": "acceptance_decision", "from": "acceptance", "to": "decision", "variant": "default", "fromSide": "right", "toSide": "right", "route": "outside-right" },
    { "id": "source_fixture", "from": "source", "to": "fixture", "label": "脱敏保存", "variant": "dashed", "role": "branch" },
    { "id": "permission_auth", "from": "permission", "to": "auth", "label": "会话前置", "variant": "security", "role": "branch" }
